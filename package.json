{
  "name": "api-tasks-prisma",
  "version": "1.0.0",
  "description": "API REST de tarefas com autenticação JWT, refresh token rotation, RBAC (roles e permissions), Prisma e PostgreSQL",
  "main": "src/server.js",
  "scripts": {
    "test": "vitest run",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:test": "cross-env NODE_ENV=test prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.3"
  }
}
